# =====================================================================
# First UMC & Wesley Foundation — Apache configuration
# =====================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ---- Tidy URL for the CMS: /admin instead of /admin.html ----------
    #
    # Anyone who lands on the old address, or adds a trailing slash, is
    # sent to /admin so there is only ever one address to bookmark.
    # (The trailing slash matters: without this, relative links inside
    # the page would look for /admin/api.php instead of /api.php.)
    RewriteCond %{THE_REQUEST} \s/+admin\.html[\s?] [NC]
    RewriteRule ^ /admin [R=301,L]

    RewriteRule ^admin/$ /admin [R=301,L]

    # Serve the CMS at /admin without changing the address bar.
    RewriteRule ^admin$ admin.html [L]

    # ---- Pages made in the CMS ----------------------------------------
    #
    # Pages have tidy addresses of their own — /about, /events, /give —
    # but there is no file behind them: index.html looks at the address
    # and draws the matching page. So anything that is not a real file,
    # a real folder, or one of the site's own PHP endpoints is handed to
    # index.html to resolve.
    #
    # A page whose slug no longer exists still reaches index.html, which
    # shows a "page not found" message rather than an Apache error.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/(api|db|mailer|migrate|config|router)\.php$ [NC]
    RewriteCond %{REQUEST_URI} !^/(uploads|data)/ [NC]
    RewriteRule ^ index.html [L]
</IfModule>

# ---- Keep private files private ---------------------------------------
# If PHP is ever misconfigured or switched off, these must not be
# downloadable as plain text: config.php holds the admin password.
<FilesMatch "^(config\.php|config\.sample\.php|mailer\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Never serve the repository metadata if the site is deployed with git.
RedirectMatch 404 /\.git

# ---- Small niceties ---------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header always append X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg  "access plus 1 month"
    ExpiresByType image/png   "access plus 1 month"
    ExpiresByType image/webp  "access plus 1 month"
    ExpiresByType image/gif   "access plus 1 month"
    # The site and CMS must always be fresh, so they are left uncached.
</IfModule>
