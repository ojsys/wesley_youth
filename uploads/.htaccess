# Photos uploaded through the CMS live here.
# Nothing in this folder may ever be executed as a script.
php_flag engine off
<FilesMatch "\.(php|phtml|php[0-9]|phar|cgi|pl|py|sh|html?)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
